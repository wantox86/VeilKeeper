# Copy this file to .env and fill in real values for local development.
# NEVER commit the real .env file (it's already in .gitignore).

# --- API ---
HTTP_PORT=8080

# --- Auth (Sprint 1) ---
# Server-side secret used ONLY to derive a deterministic fake KDF salt for
# /auth/prelogin anti-enumeration responses (never used as/to derive any real
# encryption key). Set to a random string (32+ bytes recommended) in any
# deployment that should survive restarts with stable anti-enumeration
# behavior. If unset, the server generates a random ephemeral one at startup
# (fine for local dev, logged as a warning).
SERVER_PEPPER=changeme-dev-pepper-generate-a-real-random-value

# How long an issued session token stays valid.
SESSION_TTL_HOURS=720

# Max requests per IP per minute across all /api/v1/auth/* endpoints.
AUTH_RATE_LIMIT_REQUESTS=20

# Comma-separated list of invite codes required by POST /auth/register
# (invite-code gate, post-launch task). FAIL-CLOSED: if this is unset/empty,
# ALL registrations are rejected with "registration is currently closed" --
# it does NOT fall back to open registration. Existing accounts/logins are
# never affected by this setting; it only gates *new* registrations. Already
# covered by AUTH_RATE_LIMIT_REQUESTS above (same route, same rate limiter),
# so codes can't be brute-forced quickly. Placeholder values below -- DO NOT
# use these in production, generate real ones (e.g. `openssl rand -hex 8`).
INVITE_CODES=family2026,friend2026

# --- CORS (Web Sprint 2) ---
# Comma-separated allowlist of browser origins permitted to make
# cross-origin requests to this API (e.g. the Web client). Deliberately
# never a wildcard -- this is a zero-knowledge auth backend. Does not affect
# native clients (Android app, curl, server-to-server) since those never
# send an Origin header. Default below covers the Vite dev server
# (http://localhost:5173 / http://127.0.0.1:5173), plus the Web Sprint 8
# internal/LAN-only production deployment origin
# (https://<MACMINI-LAN-IP>:18092 -- HTTPS, not HTTP: `web` terminates TLS
# with a self-signed cert so crypto.subtle works as a secure context off the
# host itself, see web/nginx/certs/generate-cert.sh) -- see CLAUDE.md "Web
# client (Sprint roadmap)" and docker-compose.yml's `web` service). Replace
# 192.168.50.131 below with your own homelab host's LAN IP if different.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://192.168.50.131:18092

# --- Attachments (Sprint 5) ---
# Root directory encrypted attachment blobs are written to/read from. Must
# match the docker-compose.yml bind mount target -- do not change without
# also updating that. Not a secret; safe to leave at the default.
ATTACHMENTS_DIR=/data/attachments

# --- MySQL ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=veilkeeper
DB_USER=veilkeeper
DB_PASSWORD=changeme-dev-password
DB_ROOT_PASSWORD=changeme-dev-root-password
