<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Phase 6: Compose (ui/theme/Theme.kt) owns all actual Material 3
         colors/typography at runtime. This XML theme only controls the
         pre-Compose window background shown for a frame on cold start,
         set to match our light "Midnight Vault" background so there's no
         mismatched flash before Compose draws. The values-night variant of
         this file provides the dark counterpart. -->
    <style name="Theme.VeilKeeper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
