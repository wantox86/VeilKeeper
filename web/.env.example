# Copy this file to .env for local development (already gitignored, like the
# root repo's own .env pattern -- see ../CLAUDE.md).
#
# Base URL of the VeilKeeper backend API, INCLUDING trailing slash. Mirrors
# the pattern used by Android's `apiBaseUrl` Gradle property
# (android/app/build.gradle.kts) -- never hardcode a backend URL in source.
#
# Local dev against `docker compose up -d` at the repo root (host port
# 18091, see root README.md):
VITE_API_BASE_URL=http://localhost:18091/

# To manually verify connectivity against the live backend instead (read-only
# health check -- never point write-capable dev work at production):
# VITE_API_BASE_URL=https://veilkeeper.quezacolt.my.id/
